// =============================================================================
// RISC-V RV32IM Assembly Firmware Hex File (4-element MAC + Division)
// Memory base address: 0x0000_0000
// =============================================================================
@00000000
10000413 // 00: addi s0, zero, 0x100 (Ptr to Vector X)
01040493 // 04: addi s1, s0, 0x10    (Ptr to Vector W)
02040913 // 08: addi s2, s0, 0x20    (Ptr to Result Acc)
00000693 // 0C: addi a3, zero, 0     (Clear Acc = 0)
00042503 // 10: lw   a0, 0(s0)       (Load X[0] = 3)
0004a583 // 14: lw   a1, 0(s1)       (Load W[0] = 2)
02b50633 // 18: mul  a2, a0, a1      (a2 = 3 * 2 = 6)
00c686b3 // 1C: add  a3, a3, a2      (Acc = 0 + 6 = 6)
00442503 // 20: lw   a0, 4(s0)       (Load X[1] = 7)
0044a583 // 24: lw   a1, 4(s1)       (Load W[1] = -3)
02b50633 // 28: mul  a2, a0, a1      (a2 = 7 * -3 = -21)
00c686b3 // 2C: add  a3, a3, a2      (Acc = 6 + (-21) = -15)
00842503 // 30: lw   a0, 8(s0)       (Load X[2] = -4)
0084a583 // 34: lw   a1, 8(s1)       (Load W[2] = 6)
02b50633 // 38: mul  a2, a0, a1      (a2 = -4 * 6 = -24)
00c686b3 // 3C: add  a3, a3, a2      (Acc = -15 + (-24) = -39)
00c42503 // 40: lw   a0, 12(s0)      (Load X[3] = 5)
00c4a583 // 44: lw   a1, 12(s1)      (Load W[3] = 4)
02b50633 // 48: mul  a2, a0, a1      (a2 = 5 * 4 = 20)
00c686b3 // 4C: add  a3, a3, a2      (Acc = -39 + 20 = -19)
00d92023 // 50: sw   a3, 0(s2)       (Store -19 to 0x120 via AXI)
fed00293 // 54: addi t0, zero, -19   (t0 = -19)
00400313 // 58: addi t1, zero, 4     (t1 = 4)
0262c3b3 // 5C: div  t2, t0, t1      (t2 = -19 / 4 = -4)
0262ee33 // 60: rem  t3, t0, t1      (t3 = -19 % 4 = -3)
0000006f // 64: jal  zero, 0         (Halt Loop)

// Vector X at word address 0x40 (Byte offset 0x100)
@00000040
00000003 // X[0] = 3
00000007 // X[1] = 7
fffffffc // X[2] = -4
00000005 // X[3] = 5

// Vector W at word address 0x44 (Byte offset 0x110)
@00000044
00000002 // W[0] = 2
fffffffd // W[1] = -3
00000006 // W[2] = 6
00000004 // W[3] = 4

// Result Location at word address 0x48 (Byte offset 0x120)
@00000048
00000000
